# MongoDB connection string — use MongoDB Atlas (mongodb+srv://...) for production or mongodb://localhost:27017/university-portal for local dev
MONGODB_URI=mongodb://localhost:27017/university-portal

# Public app URL — used in invitation emails
APP_URL=http://localhost:3000

# SMTP settings for sending invitation emails to students and admins
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM="St Jude University <noreply@example.com>"

# Generate a random secret of at least 32 characters; used only to HMAC-hash login identifiers for rate limiting
AUTH_RATE_LIMIT_SECRET=replace-with-a-random-secret-at-least-32-characters

# Base64-encoded random 32-byte key used for AES-256-GCM TOTP-secret encryption
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOTP_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key

# Random secret of at least 32 characters used to HMAC-hash one-time recovery codes
TOTP_RECOVERY_HASH_KEY=replace-with-a-random-secret-at-least-32-characters

# WebAuthn relying party config
# For local development use WEBAUTHN_RP_ID=localhost and WEBAUTHN_ORIGIN=http://localhost:3000
# Production must use the exact HTTPS portal origin and its domain
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000
