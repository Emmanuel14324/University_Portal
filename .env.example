NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Use the publishable key only. Never put a Supabase secret/service-role key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Server-only key for trusted Route Handler operations. Never expose this to browser code.
SUPABASE_SECRET_KEY=your-supabase-secret-key
# Generate a random secret of at least 32 characters; used only to hash login identifiers for throttling.
AUTH_RATE_LIMIT_SECRET=replace-with-a-random-secret-at-least-32-characters
# Base64-encoded random 32-byte key used for AES-256-GCM TOTP-secret encryption.
TOTP_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
# Random secret of at least 32 characters used to hash one-time recovery codes.
TOTP_RECOVERY_HASH_KEY=replace-with-a-random-secret-at-least-32-characters
# For local development use WEBAUTHN_RP_ID=localhost and WEBAUTHN_ORIGIN=http://localhost:3000.
# Production must use the exact HTTPS portal origin and its domain/RP ID.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000
